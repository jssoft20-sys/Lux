# ===================== PayGo — переменные окружения =====================
# Скопируйте в .env и заполните. Секреты генерируются: python -m paygo.cli gen-secrets

# production | dev | test
APP_ENV=production
APP_NAME=PayGo
HOST=127.0.0.1
PORT=7035
PUBLIC_URL=https://wwweeewww.fit
# админка и API доступны по https://wwweeewww.fit/paygo/
BASE_PATH=/paygo
TIMEZONE=Asia/Bishkek
LOG_LEVEL=info
# загрузки, кэш; должен быть доступен на запись
DATA_DIR=/home/PayGo/data
# за nginx: брать IP из X-Forwarded-For
TRUST_PROXY=true
# необязательно: только эти IP/CIDR могут открывать админку и API (пусто = без ограничения)
ADMIN_IP_ALLOWLIST=
COOKIE_SECURE=true

# --- База данных (PostgreSQL в production; SQLite только для разработки) ---
DATABASE_URL=postgresql+psycopg://paygo:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/paygo
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# распознавание QR в отдельном процессе (0 — в том же процессе)
QR_DECODE_WORKERS=1

# --- Секреты (обязательно новые, минимум 32 символа каждый) ---
SECRET_KEY=
JWT_SECRET=
SESSION_SECRET=
# ключ входящих платёжных webhook'ов: /paygo/api/webhooks/payments/<WEBHOOK_SECRET>
WEBHOOK_SECRET=
# шифрование учётных данных касс в БД
ENCRYPTION_KEY=

# --- Сессии администратора ---
# бездействие, после которого сессия истекает (продлевается при активности)
SESSION_IDLE_DAYS=14
# абсолютный максимум жизни сессии
SESSION_ABSOLUTE_DAYS=60
ACCESS_TOKEN_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Telegram ---
MAIN_BOT_TOKEN=
MAIN_BOT_USERNAME=PayGoXBot
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_USERNAME=PayOperator_bot
# через запятую: Telegram ID операторов для критических уведомлений (через бот поддержки)
ADMIN_TELEGRAM_CHAT_IDS=

# --- Claude: помощник поддержки (ключ только здесь, не в коде) ---
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
# --- Расшифровка голосовых в боте поддержки (речь → текст) ---
# off — выключено; local — faster-whisper на этом сервере (venv/bin/pip install -r requirements-stt.txt);
# openai — Whisper API (нужен OPENAI_API_KEY). Бот отвечает на голосовое как на текст, расшифровка видна в чате.
STT_PROVIDER=off
# модель для local: tiny | base | small | medium (small ≈ 500 МБ, скачивается при первом голосовом; русский и кыргызский — ок)
STT_MODEL=small
# cpu достаточно; cuda — если есть GPU
STT_DEVICE=cpu
# int8 — быстрее и меньше памяти на CPU; float16 — для GPU
STT_COMPUTE_TYPE=int8
# ключ OpenAI только для STT_PROVIDER=openai (только здесь, не в коде)
OPENAI_API_KEY=
# --- Вход в панель подтверждает этот Telegram-аккаунт в основном боте ---
LOGIN_APPROVER_TELEGRAM_ID=8274883903
LOGIN_SESSION_DAYS=30

# --- E-mail (Timeweb SMTP) ---
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PayGo <noreply@wwweeewww.fit>"

# --- Необязательный источник платежей: письма банка через IMAP (Timeweb) ---
IMAP_ENABLED=false
IMAP_HOST=imap.timeweb.ru
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SENDERS=demirbank.kg
# push-режим IMAP IDLE: письмо банка обрабатывается сразу при поступлении (false — опрос раз в IMAP_POLL_SECONDS)
IMAP_IDLE=true
# интервал опроса (сек.), если IDLE выключен или сервер его не поддерживает
IMAP_POLL_SECONDS=5

# --- Web Push (VAPID) для админки ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@wwweeewww.fit

# --- Worker ---
WORKER_POLL_SECONDS=1
# старые уведомления после рестарта не отправляются
NOTIFICATION_MAX_AGE_SECONDS=600
# зависшее зачисление → failed + уведомление
STUCK_PROCESSING_TIMEOUT_SECONDS=180

# --- Автовыплаты (перевод выводов клиенту с банковского счёта) ---
# Канал выплат: пусто — выключено; optima24 — API Optima24; fake — симулятор (для теста).
# Секреты только здесь, никогда в БД/архиве. Включение и лимиты — в админке (Автовыплаты).
PAYOUT_PROVIDER=
# Optima24 (мобильный банк). base_url взят из ошибки приложения: telebank3.optima24.kg:3080
OPTIMA24_BASE_URL=https://telebank3.optima24.kg:3080
OPTIMA24_LOGIN=
OPTIMA24_PASSWORD=
OPTIMA24_DEVICE_ID=
OPTIMA24_DEVICE_TOKEN=
OPTIMA24_SOURCE_ACCOUNT=
OPTIMA24_TIMEOUT_SECONDS=30
# telebank3 отдаёт самоподписанный сертификат. Безопасно: сохранить его цепочку в файл и указать
# путь здесь (сервер будет доверять именно ему). Крайний случай: OPTIMA24_TLS_VERIFY=false (шифрование
# остаётся, но подлинность Optima не проверяется). Сохранить сертификат:
#   openssl s_client -connect telebank3.optima24.kg:3080 -showcerts </dev/null 2>/dev/null | \
#     awk '/BEGIN CERT/,/END CERT/' > /home/PayGo/optima24-ca.pem
OPTIMA24_CA_BUNDLE=
OPTIMA24_TLS_VERIFY=true
# Несколько аккаунтов Optima24 (несколько телефонов): JSON-список. Незаданные поля берутся
# из OPTIMA24_* выше. Пусто — один аккаунт из полей выше. Коды всех аккаунтов могут идти на
# один почтовый ящик (см. OPTIMA_OTP_*), т.к. выплаты идут по одной. Пример:
# OPTIMA24_ACCOUNTS=[{"name":"phone1","login":"L1","password":"P1","source_account":"ACC1"},{"name":"phone2","login":"L2","password":"P2","source_account":"ACC2"}]
OPTIMA24_ACCOUNTS=
# Optima подтверждает каждый перевод кодом на почту. Отдельный ящик (только для кодов Optima,
# НЕ тот, что читает платежи) — PayGo сам читает код и подтверждает перевод. Gmail: включить
# IMAP и создать «пароль приложения». Свой домен (напр. на Timeweb) — проще, IMAP сразу работает.
OPTIMA_OTP_IMAP_HOST=
OPTIMA_OTP_IMAP_PORT=993
OPTIMA_OTP_IMAP_USER=
OPTIMA_OTP_IMAP_PASSWORD=
OPTIMA_OTP_IMAP_FOLDER=INBOX
# доверять как источник кода только письмам от этого отправителя (подстрока, напр. optima24.kg)
OPTIMA_OTP_SENDER=
# необязательный фильтр по теме письма (подстрока); пусто — любая тема от отправителя
OPTIMA_OTP_SUBJECT=
# как достать код: первая группа регулярки (по умолчанию — первые 4–8 цифр)
OPTIMA_OTP_CODE_REGEX=(\d{4,8})
# сколько ждать письмо с кодом после отправки перевода, сек.
OPTIMA_OTP_WAIT_SECONDS=90
