# ===================== PayGo — переменные окружения =====================
# Скопируйте в .env и заполните. Секреты генерируются: python -m paygo.cli gen-secrets

# production | dev | test
APP_ENV=production
APP_NAME=PayGo
HOST=127.0.0.1
PORT=7035
PUBLIC_URL=https://wwweeewww.fit
# админка и API доступны по https://wwweeewww.fit/paygo/
BASE_PATH=/paygo
TIMEZONE=Asia/Bishkek
LOG_LEVEL=info
# загрузки, кэш; должен быть доступен на запись
DATA_DIR=/home/PayGo/data
# за nginx: брать IP из X-Forwarded-For
TRUST_PROXY=true
COOKIE_SECURE=true

# --- База данных (PostgreSQL в production; SQLite только для разработки) ---
DATABASE_URL=postgresql+psycopg://paygo:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/paygo
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Секреты (обязательно новые, минимум 32 символа каждый) ---
SECRET_KEY=
JWT_SECRET=
SESSION_SECRET=
# ключ входящих платёжных webhook'ов: /paygo/api/webhooks/payments/<WEBHOOK_SECRET>
WEBHOOK_SECRET=
# шифрование учётных данных касс в БД
ENCRYPTION_KEY=

# --- Сессии администратора ---
# бездействие, после которого сессия истекает (продлевается при активности)
SESSION_IDLE_DAYS=14
# абсолютный максимум жизни сессии
SESSION_ABSOLUTE_DAYS=60
ACCESS_TOKEN_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Telegram ---
MAIN_BOT_TOKEN=
MAIN_BOT_USERNAME=PayGoXBot
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_USERNAME=PayOperator_bot
# через запятую: Telegram ID операторов для критических уведомлений (через бот поддержки)
ADMIN_TELEGRAM_CHAT_IDS=

# --- E-mail (Timeweb SMTP) ---
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PayGo <noreply@wwweeewww.fit>"

# --- Необязательный источник платежей: письма банка через IMAP (Timeweb) ---
IMAP_ENABLED=false
IMAP_HOST=imap.timeweb.ru
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SENDERS=demirbank.kg
IMAP_POLL_SECONDS=5

# --- Web Push (VAPID) для админки ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@wwweeewww.fit

# --- Worker ---
WORKER_POLL_SECONDS=1
# старые уведомления после рестарта не отправляются
NOTIFICATION_MAX_AGE_SECONDS=600
# зависшее зачисление → failed + уведомление
STUCK_PROCESSING_TIMEOUT_SECONDS=180
