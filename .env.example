# Copy to .env is NOT needed — pass these as environment variables (systemd Environment=... or export before node server.js)
PORT=7033
HOST=0.0.0.0

# Заявки на почту (SMTP). Примеры:
#  Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<app password 16 символов>
#  Yandex:  SMTP_HOST=smtp.yandex.ru  SMTP_PORT=465  SMTP_USER=you@yandex.ru  SMTP_PASS=<пароль приложения>
#  Mail.ru: SMTP_HOST=smtp.mail.ru    SMTP_PORT=465  SMTP_USER=you@mail.ru    SMTP_PASS=<пароль для внешних приложений>
MAIL_TO=booking@helihop-travel.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM=HeliHop <you@gmail.com>

# Заявки в Telegram (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Просмотр заявок: GET /api/bookings?token=...
ADMIN_TOKEN=
