# LuxOn Optima Hub — configuration template.
# Copy to `.env` and fill in.  NEVER commit the real .env (it is gitignored).
# Load it into the environment before starting, e.g.:
#   set -a; . ./.env; set +a; python3 optima.py --serve

# ----- Admin panel -----
# Password for the web admin panel. REQUIRED — set your own secret value here.
# If left empty, a random password is generated on first run and written to
# data/admin_password.txt (and printed once in the logs).
OPTIMA_ADMIN_PASSWORD=

# ----- Server -----
OPTIMA_HOST=127.0.0.1
OPTIMA_PORT=7094
# Public base URL (used to build the API endpoints shown in the panel / curl).
# e.g. https://hub.example.com  — leave empty for local use.
OPTIMA_PUBLIC_URL=

# Where the encrypted database + master.key live (default: ./data).
OPTIMA_DIR=./data

# Background polling interval in seconds (how fast new transactions are picked
# up). 2–3s gives near-real-time updates without hammering the bank.
OPTIMA_SYNC_SECONDS=3

# ----- Chromium login helper -----
# Optional explicit Chromium/Chrome binary. If empty, Playwright's own browser
# is used (install once with:  npx playwright install chromium).
OPTIMA_CHROMIUM_PATH=
# Max seconds for a single Chromium login (reCAPTCHA + TOTP).
OPTIMA_LOGIN_TIMEOUT=100
# Only needed behind an egress proxy that re-terminates TLS (dev sandboxes):
# OPTIMA_HTTPS_PROXY=http://127.0.0.1:8080
# OPTIMA_TLS_MAX=tls1.2

# ----- Seed a pre-linked wallet on first `--init` (optional) -----
# These are read only by `--init` / `--add` to create the first wallet, then
# stored encrypted in the database. Leave empty to add wallets via the panel.
OPTIMA_SEED_NAME=
OPTIMA_SEED_ID=
OPTIMA_SEED_PASSWORD=
OPTIMA_SEED_TOTP=
OPTIMA_SEED_ALLOWED_IP=
