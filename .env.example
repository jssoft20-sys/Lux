# ===================== LUX TRADING BOT — настройки =====================
# Скопируйте этот файл в .env и заполните. Файл .env НЕ попадает в git.

# ---------- Binance ----------
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Приватные запросы (баланс, ордера). На сервере вне США оставьте как есть.
BINANCE_API_URL=https://api.binance.com
# Публичные рыночные данные (не тратят лимиты основного хоста).
BINANCE_DATA_URL=https://data-api.binance.vision
BINANCE_WS_URL=wss://data-stream.binance.vision

# paper  — виртуальная торговля на реальных ценах (деньги не тратятся)
# live   — РЕАЛЬНЫЕ ордера на вашем счёте Binance
TRADING_MODE=paper
QUOTE_ASSET=USDT
# Пары, которыми торгует бот. Должны быть в белом списке вашего API-ключа.
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,ADAUSDT,AVAXUSDT,AAVEUSDT,BCHUSDT,ALGOUSDT,AXSUSDT,1INCHUSDT,BATUSDT,BANDUSDT,BELUSDT,BNTUSDT,C98USDT,ACMUSDT,ALICEUSDT,AVAUSDT,LINKUSDT,LTCUSDT,ETCUSDT
# Стартовый виртуальный баланс для paper-режима
PAPER_START_BALANCE=50

# ---------- Риск и стратегия ----------
POSITION_SIZE_USDT=10        # сумма одной сделки (минимум Binance ~5 USDT)
MAX_POSITION_PCT=0.35        # не больше этой доли свободного баланса в одну сделку
MAX_POSITIONS=3              # одновременно открытых позиций
TAKE_PROFIT_PCT=1.2          # фиксировать прибыль при +1.2%
STOP_LOSS_PCT=0.8            # закрывать при -0.8%
TRAILING_STOP_PCT=0.5        # трейлинг-стоп 0.5% от максимума
TRAILING_ACTIVATION_PCT=0.5  # трейлинг включается после +0.5%
MAX_HOLD_MINUTES=45          # принудительный выход по времени
BUY_THRESHOLD=0.35           # композитный сигнал для входа (0..1)
EXIT_THRESHOLD=-0.25         # композитный сигнал для выхода
MIN_NEWS_SCORE=0.05          # входить только при хотя бы слабо позитивном новостном фоне
DAILY_LOSS_LIMIT_USDT=8      # дневной лимит убытка — после него бот останавливается
MAX_SPREAD_BPS=15            # не входить, если спред шире 0.15%
SYMBOL_COOLDOWN_MINUTES=10   # пауза по паре после закрытия сделки
DECISION_INTERVAL_MS=100     # частота цикла принятия решений (мс)
NEWS_HALF_LIFE_MINUTES=20    # период полураспада новостного сигнала

# ---------- Новости ----------
NEWS_POLL_SECONDS=15
CRYPTOPANIC_TOKEN=           # опционально: https://cryptopanic.com/developers/api/
NEWSAPI_KEY=                 # опционально: https://newsapi.org/
EXTRA_RSS=                   # доп. RSS через запятую

# ---------- ИИ-анализ (Claude) ----------
ANTHROPIC_API_KEY=           # без ключа работает только быстрый лексический анализ
LLM_MODEL=claude-opus-5
LLM_ENABLED=true

# ---------- Сервер / дашборд ----------
HOST=0.0.0.0
PORT=7066
DASHBOARD_PASSWORD=          # ОБЯЗАТЕЛЬНО задайте на публичном сервере (логин: lux)
DB_PATH=data/lux.db
LOG_LEVEL=INFO
