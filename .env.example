# ---------------------------------------------------------------------------
# Lux — переменные окружения. Скопируй в .env и заполни те, что нужны.
# Без единого ключа приложение тоже работает: включится офлайн-режим
# (поиск по локальному индексу фильмов в data/movies.json).
# ---------------------------------------------------------------------------

# Claude — основной «мозг»: понимает пересказ, смотрит кадр, читает субтитры.
# Ключ: https://console.anthropic.com/  (или ANTHROPIC_AUTH_TOKEN / ant auth login)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Поиск по вебу внутри запроса к Claude (сильно повышает точность по описанию).
ENABLE_WEB_SEARCH=true

# TMDB — постеры, годы, ссылки, проверка что фильм вообще существует.
# Бесплатный ключ: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_LANGUAGE=ru-RU

# Распознавание речи (дорожка диалогов -> текст -> поиск по реплике).
# Подходит любой OpenAI-совместимый /audio/transcriptions:
# OpenAI, Groq, Deepgram-proxy или локальный whisper.cpp / faster-whisper server.
ASR_API_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1

# Аудио-отпечаток музыки/саундтрека (настоящий «шазам» для звуковой дорожки).
# https://audd.io/
AUDD_API_TOKEN=

# Сервер
PORT=3000
MAX_UPLOAD_MB=25
