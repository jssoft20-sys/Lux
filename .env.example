# ===================== CONTINENTAL BOT — настройки =====================
# Скопируйте этот файл в .env и заполните. Файл .env НЕ попадает в git.
# Комментарии — только на отдельных строках (иначе Docker посчитает их частью значения).

# ---------- Binance ----------
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Приватные запросы (баланс, ордера). На сервере вне США оставьте как есть.
BINANCE_API_URL=https://api.binance.com
# Публичные рыночные данные (не тратят лимиты основного хоста).
BINANCE_DATA_URL=https://data-api.binance.vision
BINANCE_WS_URL=wss://data-stream.binance.vision

# paper — виртуальная торговля на реальных ценах (деньги не тратятся)
# live  — РЕАЛЬНЫЕ ордера на вашем счёте Binance
TRADING_MODE=paper
QUOTE_ASSET=USDT
# Пары, которыми торгует бот. Должны быть в белом списке вашего API-ключа.
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,ADAUSDT,AVAXUSDT,AAVEUSDT,BCHUSDT,ALGOUSDT,AXSUSDT,1INCHUSDT,BATUSDT,BANDUSDT,BELUSDT,BNTUSDT,C98USDT,ACMUSDT,ALICEUSDT,AVAUSDT,LINKUSDT,LTCUSDT,ETCUSDT
# Стартовый виртуальный баланс для paper-режима
PAPER_START_BALANCE=50

# ---------- Риск и сигнал ----------
# Веса композитного сигнала (нормализуются): новости, импульс, стакан, поток; SMC-структура задаётся ниже
W_NEWS=0.35
W_MOMENTUM=0.20
W_ORDERBOOK=0.075
W_FLOW=0.075
# Сумма одной сделки в USDT (минимум Binance ~5 USDT)
POSITION_SIZE_USDT=10
# Не больше этой доли свободного баланса в одну сделку
MAX_POSITION_PCT=0.35
# Одновременно открытых позиций
MAX_POSITIONS=3
# Фиксировать прибыль при +1.2 %
TAKE_PROFIT_PCT=1.2
# Закрывать при -0.8 %
STOP_LOSS_PCT=0.8
# Трейлинг-стоп 0.5 % от максимума; включается после +0.5 %
TRAILING_STOP_PCT=0.5
TRAILING_ACTIVATION_PCT=0.5
# Принудительный выход по времени, минут
MAX_HOLD_MINUTES=45
# Минимальное удержание позиции, секунд (защита от «дёрганья»; стоп-лосс и тейк-профит срабатывают всегда)
MIN_HOLD_SECONDS=90
# ---------- Стратегия (по курсу SMC/ICT) ----------
# scalp  — входы по новостям/импульсу, цели от комиссии, быстрый выход
# smc    — только сетапы Smart Money: рейд ликвидности → слом структуры → POI в дисконте, RR ≥ SMC_MIN_RR
# hybrid — сетапы SMC в приоритете (стоп за свипом, цели по ликвидности), остальное — скальп
STRATEGY=hybrid
W_SMC=0.30
SMC_MIN_RR=3
SMC_MAX_HOLD_MINUTES=180
# Доля позиции, фиксируемая на TP1; остаток идёт к TP2 со стопом в безубытке и трейлингом за свингом
PARTIAL_TP_PCT=50
# Риск на сделку для SMC-сетапов (% от эквити): объём = риск / расстояние до стопа. После убытка — сниженный
RISK_PER_TRADE_PCT=1
RISK_REDUCED_PCT=0.5
# Просадка, при которой торговля останавливается (0 = выкл)
DAILY_DRAWDOWN_PCT=2
WEEKLY_DRAWDOWN_PCT=4
# В стратегии smc: убыточная сделка завершает сессию
STOP_AFTER_LOSS_IN_SESSION=true
# Оптимальное торговое время (UTC): 07:00–12:30 и 14:45–17:45 МСК. OTT_ONLY=true запрещает входы вне окон
OTT_WINDOWS=04:00-09:30,11:45-14:45
OTT_ONLY=false
# Дни со сниженным риском, например mon,fri (пусто = нет)
REDUCED_RISK_DAYS=

# Скальп-режим: цели считаются от комиссии Binance, а не фиксированными процентами
SCALP_MODE=true
# Тейк-профит = комиссия за круг (0.2 %) × множитель; при 2.5 это +0.5 %, стоп −0.4 %
FEE_MULTIPLE=2.5
# Сколько минут максимум держать скальп
SCALP_MAX_HOLD_MINUTES=12
# Композитный сигнал для входа (0..1) и для выхода
BUY_THRESHOLD=0.35
EXIT_THRESHOLD=-0.25
# Входить только при хотя бы слабо позитивном новостном фоне
MIN_NEWS_SCORE=0.05
# Дневной лимит убытка в USDT — после него бот останавливается до полуночи UTC
DAILY_LOSS_LIMIT_USDT=8
# Не входить, если спред шире 0.15 % (15 базисных пунктов)
MAX_SPREAD_BPS=15
# Пауза по паре после закрытия сделки, минут (после убытка — вдвое дольше)
SYMBOL_COOLDOWN_MINUTES=10
# Частота цикла принятия решений, мс
DECISION_INTERVAL_MS=100
# Период полураспада новостного сигнала, минут
NEWS_HALF_LIFE_MINUTES=20

# ---------- Новости ----------
NEWS_POLL_SECONDS=15
# Опционально: https://cryptopanic.com/developers/api/
CRYPTOPANIC_TOKEN=
# Опционально: https://newsapi.org/
NEWSAPI_KEY=
# Дополнительные RSS через запятую
EXTRA_RSS=

# ---------- ИИ-анализ (Claude + GPT работают вместе, если заданы оба ключа) ----------
# Без ключей работает только быстрый лексический анализ новостей
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDERS=anthropic,openai
LLM_ENABLED=true
# Заголовки старше этого возраста (минут) в ИИ не отправляются — экономия токенов
LLM_MAX_AGE_MINUTES=90

# ---------- Сервер / дашборд ----------
HOST=0.0.0.0
PORT=7066
# ОБЯЗАТЕЛЬНО задайте на публичном сервере. Логин: lux
DASHBOARD_PASSWORD=
DB_PATH=data/lux.db
LOG_LEVEL=INFO
