# Порт и адрес, на которых слушает сервер
PORT=7088
HOST=0.0.0.0

# Логин/пароль администратора создаются при первом запуске (потом меняются в админке)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Публичный адрес сайта для ссылок в сообщениях (если пусто — берётся из запросов, например http://1.2.3.4:7088)
PUBLIC_URL=

# Если сервер стоит за nginx/Cloudflare — 1, иначе 0
TRUST_PROXY=0

# Максимальный размер загружаемого фото, МБ
MAX_UPLOAD_MB=12

# Секрет для cookie админки (если пусто — создаётся автоматически в data/secret.key)
SESSION_SECRET=
