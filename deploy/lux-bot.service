[Unit]
Description=Lux news-driven trading bot (Binance Spot) — dashboard on port 7066
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lux
Group=lux
WorkingDirectory=/opt/lux-bot
EnvironmentFile=/opt/lux-bot/.env
ExecStart=/opt/lux-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
LimitNOFILE=65536
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/lux-bot/data

[Install]
WantedBy=multi-user.target
