# ───────────── Somex TEST deployment (single port) ─────────────
NODE_ENV=production
TEST_MODE=true
TEST_OTP_CODE=000000
DEV_SIMULATE_CHAIN=true
OTP_DEV_ECHO=false

API_PORT=7055
API_PUBLIC_URL=http://SERVER_IP:7055
CORS_ORIGINS=http://SERVER_IP:7055

DATABASE_URL=postgresql://somex:somex@localhost:5432/somex?schema=public
REDIS_URL=redis://localhost:6379

# generated by install.sh (openssl rand -hex 32)
MASTER_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# built web apps served by the API
WEB_MOBILE_DIR=../web/mobile
WEB_ADMIN_DIR=../web/admin

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_FAIL_MODE=fail_open

ADMIN_EMAIL=admin@somex.kg
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Superadmin

# optional integrations (can also be set later in Admin → Настройки)
WAPPI_TOKEN=
WAPPI_PROFILE_ID=
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
