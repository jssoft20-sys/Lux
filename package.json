{
  "name": "somex",
  "version": "1.0.0",
  "private": true,
  "description": "Somex — P2P USDT platform for Kyrgyzstan: escrow, KYC, anti-fraud, Web3 wallet, admin control center",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "pnpm --filter @somex/shared build",
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter @somex/api dev",
    "dev:mobile": "pnpm --filter @somex/mobile dev",
    "dev:admin": "pnpm --filter @somex/admin dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @somex/shared build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @somex/api prisma:generate",
    "db:migrate": "pnpm --filter @somex/api prisma:migrate",
    "db:deploy": "pnpm --filter @somex/api prisma:deploy",
    "db:seed": "pnpm --filter @somex/api prisma:seed",
    "db:studio": "pnpm --filter @somex/api prisma:studio",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
