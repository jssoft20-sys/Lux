# ===================== OnoiPay — переменные окружения =====================
# Скопируйте в .env и заполните. Секреты генерируются: python -m onoipay.cli gen-secrets

APP_ENV=production            # production | dev | test
APP_NAME=OnoiPay
HOST=127.0.0.1
PORT=7031
PUBLIC_URL=https://wwweeewww.fit
BASE_PATH=/onoipay            # админка и API доступны по https://wwweeewww.fit/onoipay/
TIMEZONE=Asia/Bishkek
LOG_LEVEL=info
DATA_DIR=/home/onoi/data      # загрузки, кэш; должен быть доступен на запись
TRUST_PROXY=true              # за nginx: брать IP из X-Forwarded-For
COOKIE_SECURE=true

# --- База данных (PostgreSQL в production; SQLite только для разработки) ---
DATABASE_URL=postgresql+psycopg://onoi:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/onoipay
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Секреты (обязательно новые, минимум 32 символа каждый) ---
SECRET_KEY=
JWT_SECRET=
SESSION_SECRET=
WEBHOOK_SECRET=               # ключ входящих платёжных webhook'ов: /onoipay/api/webhooks/payments/<WEBHOOK_SECRET>
ENCRYPTION_KEY=               # шифрование учётных данных касс в БД

# --- Сессии администратора ---
SESSION_IDLE_DAYS=14          # бездействие, после которого сессия истекает (продлевается при активности)
SESSION_ABSOLUTE_DAYS=60      # абсолютный максимум жизни сессии
ACCESS_TOKEN_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Telegram ---
MAIN_BOT_TOKEN=
MAIN_BOT_USERNAME=OnoiPayBot
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_USERNAME=OnoiHelpBot
ADMIN_TELEGRAM_CHAT_IDS=      # через запятую: Telegram ID операторов для критических уведомлений (через бот поддержки)

# --- E-mail (Timeweb SMTP) ---
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="OnoiPay <noreply@wwweeewww.fit>"

# --- Необязательный источник платежей: письма банка через IMAP (Timeweb) ---
IMAP_ENABLED=false
IMAP_HOST=imap.timeweb.ru
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SENDERS=demirbank.kg
IMAP_POLL_SECONDS=5

# --- Web Push (VAPID) для админки ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@wwweeewww.fit

# --- Worker ---
WORKER_POLL_SECONDS=1
NOTIFICATION_MAX_AGE_SECONDS=600      # старые уведомления после рестарта не отправляются
STUCK_PROCESSING_TIMEOUT_SECONDS=180  # зависшее зачисление → failed + уведомление
