[Unit]
Description=OnoiPay support Telegram bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=onoi
Group=onoi
WorkingDirectory=/home/onoi/onoi
EnvironmentFile=/home/onoi/onoi/.env
ExecStart=/home/onoi/onoi/venv/bin/python -m onoibot.support_bot
Restart=always
RestartSec=3
TimeoutStopSec=25
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/home/onoi/data /home/onoi/onoi
StandardOutput=append:/home/onoi/logs/support.log
StandardError=append:/home/onoi/logs/support.log

[Install]
WantedBy=multi-user.target
