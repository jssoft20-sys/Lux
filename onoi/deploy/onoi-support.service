# OnoiPay — Telegram-бот поддержки.
# Устанавливается в /etc/systemd/system/onoi-support.service (install.sh).
#
# Запуск от отдельного пользователя: см. комментарий в onoi-server.service
# (User=onoi, Group=onoi, chown -R onoi:onoi /home/onoi).
[Unit]
Description=OnoiPay support Telegram bot
After=network-online.target onoi-server.service
Wants=network-online.target onoi-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/onoi
Environment=PORT=7030
Environment=HOST=127.0.0.1
Environment=ONOI_URL_PREFIX=/onoipay
Environment=ONOI_API_BASE=http://127.0.0.1:7030/onoipay/api
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/onoi/venv/bin/python /home/onoi/bots/support_bot.py
Restart=always
RestartSec=2
LimitNOFILE=65536
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
